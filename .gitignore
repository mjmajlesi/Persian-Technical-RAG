# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
dist/
build/
*.egg-info/
.eggs/

# Environment & secrets
.env
.env.*
*.key

# Test & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
*.log

# Data artifacts (large/regenerable; manifests + eval sets + ids.json stay tracked)
data/index/*/faiss.index
data/index/*/chunks.jsonl
data/eval/**/reports/*.json
!data/eval/reports/.gitkeep
# Official v2 JSON is versioned; incomplete per-item diagnostics are not.
!data/eval/*/reports/v2/*/*.json
data/eval/*/reports/v2/*/*.diagnostics.json
data/research/embedding-compare/*/*/embeddings-*.npy
data/research/embedding-compare/*/*/faiss.index

# OS / editors
.DS_Store
Thumbs.db
*.tmp
*.swp
.vscode/
.idea/
